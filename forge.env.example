# .env for FORGE (compose reads this into the container environment)
#
# Master password — required to generate/clear API keys from the dashboard.
# Without this, the Generate/Clear buttons are disabled.
# FORGE_MASTER_PASSWORD=set-a-strong-password-here
#
# Admin API key for /admin/v1/* (the "API Key" field in the dashboard must match).
# Leave absent or empty to run with admin OPEN.
# FORGE_API_KEY=set-a-lo-n-g-rando…ring
#
# Only needed to pull gated models from HuggingFace:
# FORGE_HF_TOKEN=hf_xxx
