# .env for FORGE (compose reads this into the container environment)
#
# Admin API key for /admin/v1/* (dashboard "Admin key" field must match this).
# Leave the file absent, or leave this line empty, to run with admin OPEN.
# FORGE_API_KEY=set-a-lo-n-g-rando…ring

# Only needed to pull gated models from HuggingFace:
# HUGGINGFACE_HUB_TOKEN=hf_xxx
